{
  "name": "veripy-sdk",
  "version": "1.0.4",
  "description": "Email verification wrapper for Veripy",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "verification",
    "email",
    "veripy",
    "spam"
  ],
  "author": "Richard Banguiz",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/veripy.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/your-org/veripy/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/your-org/veripy/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}